#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX 100
#define ARQ_ENTRADA "dados.txt"
#define ARQ_SAIDA   "ordenado.txt"

void limparBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) { }
}

int lerInteiro(const char *mensagem) {
    int valor, r;
    printf("%s", mensagem);
    while ((r = scanf("%d", &valor)) != 1) {
        if (r == EOF) {
            printf("\nEntrada encerrada. Saindo...\n");
            exit(0);
        }
        limparBuffer();
        printf("Entrada invalida. %s", mensagem);
    }
    limparBuffer();
    return valor;
}

void trocar(int *a, int *b) {
    int aux = *a;
    *a = *b;
    *b = aux;
}

void exibirVetor(const char *titulo, const int *v, int n) {
    int i;
    printf("%s", titulo);
    for (i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");
}

int gravarArquivo(const char *nome, const int *v, int n) {
    int i;
    FILE *arq = fopen(nome, "w");
    if (arq == NULL) {
        printf("Erro ao criar o arquivo %s\n", nome);
        return 0;
    }
    for (i = 0; i < n; i++) {
        fprintf(arq, "%d\n", v[i]);
    }
    fclose(arq);
    return 1;
}

int lerArquivo(const char *nome, int *v, int max) {
    int n = 0, extra;
    FILE *arq = fopen(nome, "r");
    if (arq == NULL) {
        printf("Erro: nao foi possivel abrir %s (crie o arquivo primeiro).\n", nome);
        return -1;
    }
    while (n < max && fscanf(arq, "%d", &v[n]) == 1) {
        n++;
    }

    if (fscanf(arq, "%d", &extra) != EOF) {
        printf("Erro: %s tem mais de %d valores ou contem texto invalido.\n", nome, max);
        fclose(arq);
        return -1;
    }
    fclose(arq);
    return n;
}

void bubbleSort(int *v, int n) {
    int i, j, trocou;
    for (i = 0; i < n - 1; i++) {
        trocou = 0;
        for (j = 0; j < n - i - 1; j++) {
            if (v[j] > v[j + 1]) {
                trocar(&v[j], &v[j + 1]);
                trocou = 1;
            }
        }
        if (!trocou) break;
    }
}

void insertionSort(int *v, int n) {
    int i, j, chave;
    for (i = 1; i < n; i++) {
        chave = v[i];
        j = i - 1;
        while (j >= 0 && v[j] > chave) {
            v[j + 1] = v[j];
            j--;
        }
        v[j + 1] = chave;
    }
}

void selectionSort(int *v, int n) {
    int i, j, min;
    for (i = 0; i < n - 1; i++) {
        min = i;
        for (j = i + 1; j < n; j++) {
            if (v[j] < v[min]) min = j;
        }
        if (min != i) trocar(&v[i], &v[min]);
    }
}

void merge(int *v, int inicio, int meio, int fim) {
    int n1 = meio - inicio + 1;
    int n2 = fim - meio;
    int i, j, k;
    int *L = (int *) malloc(n1 * sizeof(int));
    int *R = (int *) malloc(n2 * sizeof(int));

    if (L == NULL || R == NULL) {
        printf("Erro de memoria no Merge Sort.\n");
        free(L);
        free(R);
        return;
    }

    for (i = 0; i < n1; i++) L[i] = v[inicio + i];
    for (j = 0; j < n2; j++) R[j] = v[meio + 1 + j];

    i = 0; j = 0; k = inicio;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) v[k++] = L[i++];
        else              v[k++] = R[j++];
    }
    while (i < n1) v[k++] = L[i++];
    while (j < n2) v[k++] = R[j++];

    free(L);
    free(R);
}

void mergeSort(int *v, int inicio, int fim) {
    if (inicio < fim) {
        int meio = (inicio + fim) / 2;
        mergeSort(v, inicio, meio);
        mergeSort(v, meio + 1, fim);
        merge(v, inicio, meio, fim);
    }
}

void quickSort(int *v, int inicio, int fim) {
    int i = inicio, j = fim;
    int pivo = v[(inicio + fim) / 2];

    while (i <= j) {
        while (v[i] < pivo) i++;
        while (v[j] > pivo) j--;
        if (i <= j) {
            trocar(&v[i], &v[j]);
            i++;
            j--;
        }
    }
    if (inicio < j) quickSort(v, inicio, j);
    if (i < fim)    quickSort(v, i, fim);
}

const char *nomeAlgoritmo(int tipo) {
    switch (tipo) {
        case 1:  return "Bubble Sort";
        case 2:  return "Insertion Sort";
        case 3:  return "Selection Sort";
        case 4:  return "Merge Sort";
        case 5:  return "Quick Sort";
        default: return "Desconhecido";
    }
}

int escolherAlgoritmo(void) {
    int tipo;
    do {
        printf("\nEscolha o tipo de ordenacao:\n");
        printf("  1 - Bubble Sort\n");
        printf("  2 - Insertion Sort\n");
        printf("  3 - Selection Sort\n");
        printf("  4 - Merge Sort\n");
        printf("  5 - Quick Sort\n");
        tipo = lerInteiro("Opcao: ");
        if (tipo < 1 || tipo > 5) {
            printf("Opcao invalida! Digite de 1 a 5.\n");
        }
    } while (tipo < 1 || tipo > 5);
    return tipo;
}

void ordenar(int *v, int n, int tipo) {
    switch (tipo) {
        case 1: bubbleSort(v, n);           break;
        case 2: insertionSort(v, n);        break;
        case 3: selectionSort(v, n);        break;
        case 4: mergeSort(v, 0, n - 1);     break;
        case 5: quickSort(v, 0, n - 1);     break;
        default: printf("Algoritmo invalido.\n");
    }
}

void opcaoCriarArquivo(void) {
    int v[MAX];
    int n, i, modo;

    do {
        n = lerInteiro("Quantos valores deseja gravar (1 a 100)? ");
        if (n < 1 || n > MAX) printf("Quantidade invalida!\n");
    } while (n < 1 || n > MAX);

    printf("\n  1 - Digitar os valores\n  2 - Gerar valores aleatorios\n");
    modo = lerInteiro("Opcao: ");

    switch (modo) {
        case 1:
            for (i = 0; i < n; i++) {
                printf("Valor %d: ", i + 1);
                v[i] = lerInteiro("");
            }
            break;
        case 2:
            srand((unsigned) time(NULL));
            for (i = 0; i < n; i++) {
                v[i] = rand() % 100 + 1;
            }
            break;
        default:
            printf("Opcao invalida. Operacao cancelada.\n");
            return;
    }

    if (gravarArquivo(ARQ_ENTRADA, v, n)) {
        printf("\nArquivo %s criado com %d valores.\n", ARQ_ENTRADA, n);
        exibirVetor("Conteudo gravado: ", v, n);
    }
}

void opcaoLerArquivo(void) {
    int v[MAX];
    int n = lerArquivo(ARQ_ENTRADA, v, MAX);
    if (n < 0) return;
    if (n == 0) {
        printf("O arquivo %s esta vazio.\n", ARQ_ENTRADA);
        return;
    }
    printf("\nForam lidos %d valores de %s.\n", n, ARQ_ENTRADA);
    exibirVetor("Valores: ", v, n);
}

void ordenarESalvar(int *v, int n) {
    int tipo = escolherAlgoritmo();

    exibirVetor("\nAntes:  ", v, n);
    ordenar(v, n, tipo);
    exibirVetor("Depois: ", v, n);

    if (gravarArquivo(ARQ_SAIDA, v, n)) {
        printf("\nOrdenado com %s e salvo em %s.\n", nomeAlgoritmo(tipo), ARQ_SAIDA);
    }
}

void opcaoOrdenar(void) {
    int v[MAX];
    int n = lerArquivo(ARQ_ENTRADA, v, MAX);
    if (n < 0) return;
    if (n == 0) {
        printf("O arquivo %s esta vazio.\n", ARQ_ENTRADA);
        return;
    }
    ordenarESalvar(v, n);
}

void opcaoAlterarEReordenar(void) {
    int v[MAX];
    int n, pos, novo;

    n = lerArquivo(ARQ_ENTRADA, v, MAX);
    if (n < 0) return;
    if (n == 0) {
        printf("O arquivo %s esta vazio.\n", ARQ_ENTRADA);
        return;
    }

    printf("\nValores atuais em %s:\n", ARQ_ENTRADA);
    for (pos = 0; pos < n; pos++) {
        printf("  [%d] = %d\n", pos + 1, v[pos]);
    }

    do {
        pos = lerInteiro("\nQual posicao deseja alterar? ");
        if (pos < 1 || pos > n) printf("Posicao invalida! Use de 1 a %d.\n", n);
    } while (pos < 1 || pos > n);

    novo = lerInteiro("Novo valor: ");
    printf("Alterando posicao %d: %d -> %d\n", pos, v[pos - 1], novo);
    v[pos - 1] = novo;

    if (!gravarArquivo(ARQ_ENTRADA, v, n)) return;
    printf("Arquivo %s atualizado.\n", ARQ_ENTRADA);

    ordenarESalvar(v, n);
}

void opcaoMostrarOrdenado(void) {
    int v[MAX];
    int n = lerArquivo(ARQ_SAIDA, v, MAX);
    if (n < 0) return;
    if (n == 0) {
        printf("O arquivo %s esta vazio.\n", ARQ_SAIDA);
        return;
    }
    printf("\nConteudo de %s (%d valores):\n", ARQ_SAIDA, n);
    exibirVetor("Valores: ", v, n);
}

int main(void) {
    int opcao;

    do {
        printf("\n===== ORDENACAO COM ARQUIVOS =====\n");
        printf("1 - Criar %s (valores desordenados)\n", ARQ_ENTRADA);
        printf("2 - Ler e exibir %s\n", ARQ_ENTRADA);
        printf("3 - Ordenar e salvar em %s\n", ARQ_SAIDA);
        printf("4 - Alterar um valor e reordenar\n");
        printf("5 - Exibir %s\n", ARQ_SAIDA);
        printf("0 - Sair\n");
        opcao = lerInteiro("Opcao: ");

        switch (opcao) {
            case 1: opcaoCriarArquivo();       break;
            case 2: opcaoLerArquivo();         break;
            case 3: opcaoOrdenar();            break;
            case 4: opcaoAlterarEReordenar();  break;
            case 5: opcaoMostrarOrdenado();    break;
            case 0: printf("Encerrando o programa...\n"); break;
            default: printf("Opcao invalida!\n");
        }
    } while (opcao != 0);

    return 0;
}
